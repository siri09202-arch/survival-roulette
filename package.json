{
  "name": "survival-roulette",
  "version": "1.0.0",
  "description": "A multiplayer real-time battle game featuring dynamic HP management, special events, and multiple game modes",
  "author": "siri09202-arch",
  "license": "MIT",
  "homepage": "https://github.com/siri09202-arch/survival-roulette",
  "repository": {
    "type": "git",
    "url": "https://github.com/siri09202-arch/survival-roulette.git"
  },
  "bugs": {
    "url": "https://github.com/siri09202-arch/survival-roulette/issues"
  },
  "keywords": [
    "game",
    "roulette",
    "multiplayer",
    "battle",
    "react",
    "firebase",
    "real-time"
  ],
  "private": false,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "firebase": "^9.23.0",
    "lucide-react": "^0.263.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@testing-library/react": "^13.4.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/user-event": "^13.5.0",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.24",
    "autoprefixer": "^10.4.14",
    "gh-pages": "^5.0.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "deploy": "npm run build && gh-pages -d build",
    "lint": "eslint src --ext .js,.jsx",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\""
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
